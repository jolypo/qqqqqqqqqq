# Telegram secrets
SIGNAL_BOT_TOKEN=
PROFIT_BOT_TOKEN=
LOSS_BOT_TOKEN=
REPORT_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SAHMK
SAHMK_API_KEY=
SAHMK_BASE_URL=https://api.sahmk.sa/api/v1
SAHMK_PLAN=free
SAHMK_MIN_REQUEST_INTERVAL=6.5
SAHMK_LOCAL_DAILY_LIMIT=95

# Telegram: auto = webhook on Render, polling locally
TELEGRAM_MODE=auto

# Runtime
PAPER_MODE=true
STATE_DIR=data
SCAN_INTERVAL_SECONDS=900
TRADE_MONITOR_QUOTES_PER_CYCLE=1
MANUAL_QUOTES_PER_SIGNAL=50
DETAIL_QUOTES_PER_SIGNAL=5
MARKET_CACHE_SECONDS=600
UNIVERSE_REFRESH_SECONDS=21600
MARKET_OPEN=10:00
MARKET_CLOSE=15:00
TIMEZONE=Asia/Riyadh
ALLOW_OFF_HOURS_SCAN=false

# Signal / risk
MIN_SCORE=75
MIN_PROBABILITY=65
MAX_DAILY_SIGNALS=3
MAX_OPEN_TRADES=5
MAX_RISK_PER_TRADE=0.01
DATA_MAX_DELAY_MINUTES=30
MIN_RR=1.5
TP1_PERCENT=30
TP2_PERCENT=30
TP3_PERCENT=40
SLIPPAGE_BPS=5
FEE_BPS=15
ALLOW_LONG=true
TRAILING_STOP_ENABLED=false
TRAILING_AFTER_TP1_TO_ENTRY=true
TRAILING_AFTER_TP2_ATR=1.0
PROFIT_ALERT_THRESHOLDS=2,5,10,15,20
NEAR_SL_WARNING_PCT=0.5
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_WEEKDAY=3
WEEKLY_REPORT_HOUR=15
WEEKLY_REPORT_MINUTE=5
